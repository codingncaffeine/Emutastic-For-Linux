<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="320"
        x:Class="Emutastic.Views.MainWindow"
        Width="640" Height="320"
        Title="Emutastic (M2 launcher)">
    <!-- Throwaway M2 launcher to exercise the emulator vertical slice.
         The real 1:1 MainWindow shell (library browser, theming) is built in M4. -->
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Emutastic — M2 vertical slice" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Pick a libretro core (.so) and a ROM, then Launch." Opacity="0.7"/>

        <TextBlock Text="Core (.so):" Margin="0,8,0,0"/>
        <DockPanel>
            <Button Name="BrowseCore" Content="Browse…" DockPanel.Dock="Right" Margin="8,0,0,0"/>
            <TextBox Name="CorePath" PlaceholderText="path to *_libretro.so"/>
        </DockPanel>

        <TextBlock Text="ROM:"/>
        <DockPanel>
            <Button Name="BrowseRom" Content="Browse…" DockPanel.Dock="Right" Margin="8,0,0,0"/>
            <TextBox Name="RomPath" PlaceholderText="path to ROM file"/>
        </DockPanel>

        <Button Name="Launch" Content="▶ Launch" HorizontalAlignment="Left" Padding="20,6"/>
        <TextBlock Name="Status" Foreground="#E03535" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
