<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org only. A local feed of a pre-release Avalonia (PR #20926, X11 drag-and-drop)
     used to be listed here; that PR shipped in Avalonia 12.1, which the csproj now pins. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
