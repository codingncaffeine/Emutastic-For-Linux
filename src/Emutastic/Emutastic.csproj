<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Match upstream's compile model: ported files rely on implicit System/System.Linq/etc. usings. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Mirror the upstream release line; surfaced in Preferences → About. -->
    <Version>1.7.6</Version>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- VENDORED: Avalonia 12.1.999 built from PR #20926 (Linux X11 drag-and-drop). Served from the
         local feed in nuget.config. Avalonia.Desktop is intentionally NOT referenced — it drags in
         macOS-only Avalonia.Native (can't build on Linux); we use Avalonia.X11 + Avalonia.Skia and
         bootstrap with UseX11().UseSkia() in Program.cs. Revert to the released package + drop the
         local feed when official Avalonia 12.1 ships. See memory: avalonia-x11-dnd-gap. -->
    <PackageReference Include="Avalonia" Version="12.1.999" />
    <PackageReference Include="Avalonia.X11" Version="12.1.999" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.999" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.999" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.999" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.999" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="LibVLCSharp" Version="3.9.4" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
  </ItemGroup>

  <!-- REMINDER (kept as a comment so builds stay warning-clean): this project pins a VENDORED
       Avalonia 12.1.999 from PR #20926 for Linux drag-and-drop. When official Avalonia 12.1 ships:
       remove the avalonia-pr20926 source in nuget.config, repin these packages to the released
       version, and restore Avalonia.Desktop + UsePlatformDetect() if desired. (Was an MSBuild
       <Warning> that nagged every build; demoted to a comment — see memory: avalonia-x11-dnd-gap.) -->
</Project>
